{
  "name": "server-next",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm db:generate && nest build",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "start:dev": "pnpm db:generate && nest start --watch",
    "start:worker:dev": "pnpm db:generate && nest start --watch --entryFile worker",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:contract": "jest --runInBand test/contract",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:smoke": "jest --config jest.smoke.config.cjs --runInBand",
    "test:e2e": "jest --config jest.e2e.config.cjs --runInBand",
    "test:all": "pnpm test:unit && pnpm test:contract && pnpm test:integration && pnpm test:smoke && pnpm test:e2e",
    "test:report": "node scripts/test-report.mjs",
    "openapi:check": "jest --runInBand test/contract/openapi.contract.spec.ts",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@nestjs/common": "11.1.12",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.12",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.12",
    "@prisma/adapter-mariadb": "7.3.0",
    "@prisma/client": "7.2.0",
    "@prisma/client-runtime-utils": "7.2.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "dotenv": "16.6.1",
    "ioredis": "5.10.1",
    "joi": "18.1.2",
    "nodemailer": "8.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.1.12",
    "@types/express": "5.0.6",
    "@types/bcrypt": "6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.7",
    "@types/nodemailer": "7.0.9",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jest": "30.2.0",
    "prettier": "3.8.0",
    "prisma": "7.2.0",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1"
  }
}
