generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "mysql"
}

/// 模型配置用途。
/// chat: 通用对话；light: 轻量判断与问题转换；
/// embedding: 向量化；rerank: 重排。
enum ModelConfigType {
  chat
  light
  embedding
  rerank
}

/// 聊天消息使用的模型配置来源。
enum ChatModelSource {
  system
  user
}

/// 知识库访问类型。
enum KnowledgeBaseVisibility {
  private
  collaborative
  public
}

/// 知识库成员和邀请的目标角色。
enum KnowledgeBaseMemberRole {
  manager
  collaborator
  member
}

/// 文档可用性；已有 active run 时，重建失败仍保持 ready。
/// deleting 从禁止访问开始，deleted 表示外部资源清理已确认完成。
enum DocumentStatus {
  processing
  ready
  failed
  deleting
  deleted
}

/// 上传传输状态；completing 必须支持重复调用与对象存储结果核对。
enum UploadSessionStatus {
  initiated
  uploading
  completing
  completed
  aborted
  expired
  failed
}

/// Multipart 分片状态，以对象存储核验结果为准。
enum UploadPartStatus {
  pending
  uploading
  uploaded
  failed
}

/// 分块产物/索引步骤状态；skipped 仅用于批次策略明确不需要的步骤。
enum ChunkStepStatus {
  pending
  processing
  completed
  failed
  skipped
}

/// succeeded 表示批次产物满足发布要求，不代表已成为 active run。
enum ProcessingRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

/// 批次汇总阶段；index 汇总两路并行索引，不能替代分块的独立索引状态。
enum ProcessingRunStage {
  parse
  chunk
  embed
  index
  completed
}

/// 任务只使用可执行阶段，不使用 completed 等汇总标记。
enum ProcessingTaskStage {
  parse
  chunk
  embed
  vector_index
  search_index
}

enum ProcessingTaskStatus {
  queued
  running
  retrying
  succeeded
  failed
  cancelled
}

/// 业务事件完成状态；dispatched 只代表已入队，completed 需消费者确认效果。
enum OutboxEventStatus {
  pending
  dispatching
  dispatched
  completed
  failed
}

/// cleanup_* 事件必须携带足够的资源清单，不能依赖已被物理删除的业务行。
enum OutboxEventType {
  dispatch_processing_task
  cleanup_document
  cleanup_run
  cleanup_knowledge_base
}

// ==========================================================
// 1. 用户与认证模块 (User & Auth)
// ==========================================================

/// 前台业务系统用户，是知识库、文档上传和聊天会话的归属主体。
model b_users {
  // 数据库自增主键。
  id                BigInt    @id @default(autoincrement())
  // 登录邮箱，作为用户唯一标识。
  email             String    @unique(map: "uk_email") @db.VarChar(255)
  // 应用层生成的密码哈希，不保存明文密码。
  password_hash     String    @db.VarChar(255)
  full_name         String?   @db.VarChar(100)
  avatar_url        String?   @db.VarChar(500)
  is_active         Boolean   @default(true)
  // 邮箱验证完成时间；为空表示尚未验证。
  email_verified_at DateTime?
  // 逻辑删除时间；为空表示未删除。
  deleted_at        DateTime?

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @updatedAt @db.DateTime(0)

  // 关联
  chat_sessions           b_chat_sessions[]
  kb_members              b_kb_members[]
  knowledge_bases         b_knowledge_bases[]
  uploaded_documents      b_documents[]          @relation("document_uploader")
  upload_sessions         b_upload_sessions[]    @relation("upload_session_user")
  model_configs           b_user_model_configs[]
  kb_invitations          b_kb_invitations[]     @relation("kb_invitation_inviter")
  accepted_kb_invitations b_kb_invitations[]     @relation("kb_invitation_acceptor")
  user_sessions           b_user_sessions[]
}

/// 前台用户登录会话，用于 Refresh Token 轮换、注销和过期控制。
model b_user_sessions {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  session_id         String    @unique(map: "uk_session_id") @db.Char(36)
  user_id            BigInt
  refresh_token_hash String    @unique(map: "uk_refresh_token_hash") @db.Char(64)
  user_agent         String?   @db.VarChar(255)
  revoked            Boolean   @default(false)
  // 会话被主动撤销的时间。
  revoked_at         DateTime?
  // 最近一次使用或刷新会话的时间。
  last_used_at       DateTime?
  expired_at         DateTime  @db.DateTime(0)
  created_at         DateTime  @default(now()) @db.DateTime(0)
  updated_at         DateTime  @updatedAt @db.DateTime(0)

  b_users b_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_id")
}

/// 邮箱验证码，支持注册、密码重置等认证场景。
model sys_email_codes {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  email      String   @db.VarChar(255)
  // 验证码哈希，不保存明文验证码。
  code_hash  String   @db.Char(64)
  purpose    Int      @db.UnsignedTinyInt
  used       Boolean  @default(false)
  expired_at DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.DateTime(0)

  @@index([email], map: "idx_email")
  @@index([email, purpose], map: "idx_email_purpose")
}

/// 后台管理系统用户，支持超级管理员和运营人员等角色。
model sys_admins {
  id            BigInt  @id @default(autoincrement())
  username      String  @unique(map: "uk_admin_username") @db.VarChar(100)
  password_hash String  @db.VarChar(255)
  role          String  @default("admin") @db.VarChar(50) // super_admin, operator
  is_active     Boolean @default(true)

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @updatedAt @db.DateTime(0)

  admin_sessions sys_admin_sessions[]
}

/// 后台管理员登录会话。
model sys_admin_sessions {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  session_id         String   @unique(map: "uk_admin_session_id") @db.Char(36)
  admin_id           BigInt
  refresh_token_hash String   @unique(map: "uk_admin_rt_hash") @db.Char(64)
  user_agent         String?  @db.VarChar(255)
  revoked            Boolean  @default(false)
  expired_at         DateTime @db.DateTime(0)
  created_at         DateTime @default(now()) @db.DateTime(0)
  updated_at         DateTime @updatedAt @db.DateTime(0)

  sys_admins sys_admins @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id], map: "idx_admin_id")
}

// ==========================================================
// 2. 大模型配置模块 (LLM Configs)
// ==========================================================

/// 系统级模型配置，密钥从环境变量读取，不保存到数据库。
model sys_model_configs {
  id           BigInt          @id @default(autoincrement())
  provider     String          @db.VarChar(50) // 模型提供商，例如 bailian / openai / deepseek
  model_name   String          @db.VarChar(100) // 模型标识，例如 qwen3.6-plus / gpt-4o
  display_name String          @db.VarChar(100) // 前端展示名称，默认与 model_name 相同
  type         ModelConfigType // 模型用途
  base_url     String?         @db.VarChar(500)
  config_json  Json? // 非敏感模型参数，例如 temperature、maxTokens、topP
  is_default   Boolean         @default(false) // 当前用途是否为默认模型
  is_active    Boolean         @default(true)
  created_at   DateTime        @default(now()) @db.DateTime(0)
  updated_at   DateTime        @updatedAt @db.DateTime(0)

  @@index([type, is_active, is_default], map: "idx_model_type_status")
}

/// 用户自定义模型配置，API Key 以 AES-256-GCM 密文保存。
model b_user_model_configs {
  id                BigInt   @id @default(autoincrement())
  user_id           BigInt
  provider          String   @db.VarChar(50)
  model_name        String   @db.VarChar(100)
  display_name      String   @db.VarChar(100) // 前端展示名称，默认与 model_name 相同
  base_url          String?  @db.VarChar(500)
  api_key_encrypted String   @db.VarChar(1024) // AES-256-GCM 加密，不保存明文
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now()) @db.DateTime(0)
  updated_at        DateTime @updatedAt @db.DateTime(0)

  b_users b_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_model")
}

// ==========================================================
// 3. 知识库与协作模块 (Knowledge Base & Collaboration)
// ==========================================================

/// 知识库主体，关联所有者、成员、邀请、文档和上传会话。
model b_knowledge_bases {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(100)
  // 知识库介绍，用于说明业务范围、内容边界和使用方式。
  description String? @db.Text
  // 知识库封面图片地址，可指向本地文件、对象存储或 CDN。
  cover_url   String? @db.VarChar(500)

  visibility            KnowledgeBaseVisibility @default(private)
  // 公开访问时是否允许下载原始文档。
  allow_public_download Boolean                 @default(false)

  owner_id   BigInt // 知识库所有者
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @updatedAt @db.DateTime(0)

  // 非空即禁止浏览、检索、上传、邀请与下载；外部清理完成后才能硬删除。
  deleted_at DateTime? @db.DateTime(0)

  documents         b_documents[]
  upload_sessions   b_upload_sessions[]
  kb_members        b_kb_members[]
  kb_invitations    b_kb_invitations[]
  message_citations b_chat_message_citations[]

  // 硬删除 owner 前必须先完成知识库归属处理及外部清理；外键不会清理 MinIO/Qdrant/ES。
  b_users b_users @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_kb_owner")

  @@index([owner_id], map: "idx_kb_owner")
  @@index([visibility, updated_at], map: "idx_kb_visibility_updated")
}

/// 知识库与用户的多对多成员关系，并保存成员角色。
model b_kb_members {
  id        BigInt                  @id @default(autoincrement())
  kb_id     BigInt
  user_id   BigInt
  // 成员角色：manager / collaborator / member
  role      KnowledgeBaseMemberRole @default(member)
  joined_at DateTime                @default(now()) @db.DateTime(0)

  b_knowledge_bases b_knowledge_bases @relation(fields: [kb_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_kb")
  b_users           b_users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_user")

  @@unique([kb_id, user_id], map: "uk_kb_user")
  @@index([user_id], map: "fk_member_user")
}

/// 知识库邀请记录，邀请码默认只能使用一次。
model b_kb_invitations {
  id               BigInt                  @id @default(autoincrement())
  kb_id            BigInt
  inviter_id       BigInt
  invite_code_hash String                  @unique @db.Char(64) // 邀请凭证哈希，不保存明文
  // 接受邀请后赋予的目标角色：manager / collaborator / member
  role             KnowledgeBaseMemberRole @default(member)
  expired_at       DateTime                @db.DateTime(0)
  cancelled_at     DateTime?
  accepted_by      BigInt?
  accepted_at      DateTime?
  created_at       DateTime                @default(now()) @db.DateTime(0)
  updated_at       DateTime                @updatedAt @db.DateTime(0)

  b_knowledge_bases b_knowledge_bases @relation(fields: [kb_id], references: [id], onDelete: Cascade)
  b_users           b_users           @relation("kb_invitation_inviter", fields: [inviter_id], references: [id], onDelete: Cascade)
  accepted_user     b_users?          @relation("kb_invitation_acceptor", fields: [accepted_by], references: [id], onDelete: SetNull)

  @@index([kb_id], map: "idx_invite_kb")
  @@index([kb_id, accepted_at, cancelled_at, expired_at], map: "idx_invite_status_lookup")
}

// ==========================================================
// 4. 文档与分块解析模块 (Documents & Chunking)
// ==========================================================

/// 文档元数据，文件内容保存在外部文件存储中。
model b_documents {
  id                BigInt  @id @default(autoincrement())
  kb_id             BigInt
  uploader_id       BigInt?
  title             String  @db.VarChar(255)
  // 首次上传时的原始文件名；用户修改展示名称时只更新 title。
  original_filename String? @db.VarChar(255)
  file_extension    String? @db.VarChar(20)
  mime_type         String? @db.VarChar(100)

  // MinIO 对象定位信息。当前系统固定使用 MinIO，但保留实际对象的完整归属信息。
  storage_provider String  @default("minio") @db.VarChar(30)
  storage_bucket   String  @db.VarChar(128)
  storage_key      String  @db.VarChar(1024)
  // Multipart Complete 返回的 ETag；不等同于文件 SHA256。
  storage_etag     String? @db.VarChar(255)

  file_size   BigInt
  // 文件完整性校验、秒传和去重使用的 SHA256。
  file_sha256 String @db.Char(64)

  // 文档可用性，不等于最新 run 状态；有有效旧批次时重建失败仍为 ready。
  status         DocumentStatus @default(processing)
  // 当前实际检索批次。外键不保证 run 属于本文档，发布事务必须校验 document_id。
  active_run_id  BigInt?
  // 最后一次发起的重建才有发布资格；创建 run 时在文档行锁保护下更新。
  // 发布必须条件匹配本字段且 deleted_at 为空；不得回退发布更早完成的 run。
  desired_run_id BigInt?

  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @updatedAt @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  upload_sessions   b_upload_sessions[]
  processing_runs   b_document_processing_runs[] @relation("document_processing_runs")
  active_run        b_document_processing_runs?  @relation("document_active_run", fields: [active_run_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_doc_active_run")
  desired_run       b_document_processing_runs?  @relation("document_desired_run", fields: [desired_run_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_doc_desired_run")
  message_citations b_chat_message_citations[]
  b_knowledge_bases b_knowledge_bases            @relation(fields: [kb_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_kb")
  b_users           b_users?                     @relation("document_uploader", fields: [uploader_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_doc_uploader")

  @@unique([active_run_id], map: "uk_doc_active_run")
  @@unique([desired_run_id], map: "uk_doc_desired_run")
  @@index([kb_id], map: "idx_kb_id")
  @@index([uploader_id], map: "idx_doc_uploader_id")
  @@index([kb_id, uploader_id], map: "idx_doc_kb_uploader")
  @@index([kb_id, status, updated_at], map: "idx_doc_kb_status_updated")
  @@index([file_sha256], map: "idx_doc_file_sha256")
}

/// MinIO Multipart Upload 上传会话。该表只记录传输过程，不记录文档处理任务。
model b_upload_sessions {
  id          BigInt  @id @default(autoincrement())
  // 对外暴露的上传会话 ID，不直接暴露数据库自增 ID。
  session_id  String  @unique(map: "uk_upload_session_id") @db.Char(36)
  kb_id       BigInt
  user_id     BigInt
  // 上传完成后才关联正式文档，因此允许为空。
  document_id BigInt?

  storage_provider    String @default("minio") @db.VarChar(30)
  storage_bucket      String @db.VarChar(128)
  storage_key         String @db.VarChar(1024)
  // MinIO 创建 Multipart Upload 后返回的真实上传 ID。
  multipart_upload_id String @unique(map: "uk_upload_multipart_id") @db.VarChar(255)

  file_name      String  @db.VarChar(255)
  title          String? @db.VarChar(255)
  file_size      BigInt
  mime_type      String? @db.VarChar(100)
  client_sha256  String? @db.Char(64)
  file_extension String? @db.VarChar(20)

  part_size      Int
  total_parts    Int
  uploaded_parts Int    @default(0)
  uploaded_bytes BigInt @default(0)

  // initiated / uploading / completing / completed / aborted / expired / failed。
  status           UploadSessionStatus @default(initiated)
  expires_at       DateTime            @db.DateTime(0)
  last_activity_at DateTime?           @db.DateTime(0)
  completed_at     DateTime?           @db.DateTime(0)
  aborted_at       DateTime?           @db.DateTime(0)
  created_at       DateTime            @default(now()) @db.DateTime(0)
  updated_at       DateTime            @updatedAt @db.DateTime(0)

  upload_parts      b_upload_parts[]
  b_knowledge_bases b_knowledge_bases @relation(fields: [kb_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_upload_session_kb")
  b_users           b_users           @relation("upload_session_user", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_upload_session_user")
  b_documents       b_documents?      @relation(fields: [document_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_upload_session_document")

  @@index([kb_id], map: "idx_upload_session_kb")
  @@index([user_id], map: "idx_upload_session_user")
  @@index([kb_id, user_id, client_sha256], map: "idx_upload_session_restore")
  @@index([document_id], map: "idx_upload_session_document")
  @@index([status, expires_at], map: "idx_upload_session_expire")
}

/// MinIO Multipart Upload 中的单个文件分片。
model b_upload_parts {
  id                BigInt           @id @default(autoincrement())
  upload_session_id BigInt
  // 使用 MinIO/S3 的 1 基分片编号。
  part_number       Int
  expected_size     Int
  actual_size       Int?
  etag              String?          @db.VarChar(255)
  checksum_sha256   String?          @db.Char(64)
  // pending / uploading / uploaded / failed。
  status            UploadPartStatus @default(pending)
  attempt_count     Int              @default(0)
  last_error        String?          @db.Text
  uploaded_at       DateTime?        @db.DateTime(0)
  created_at        DateTime         @default(now()) @db.DateTime(0)
  updated_at        DateTime         @updatedAt @db.DateTime(0)

  upload_session b_upload_sessions @relation(fields: [upload_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_upload_part_session")

  @@unique([upload_session_id, part_number], map: "uk_upload_part")
  @@index([upload_session_id, status], map: "idx_upload_part_status")
}

/// 文档某次 processing run 生成的文本切片。
/// 每个批次使用一个不可变 embedding 配置；vector_id 在批次指定的 Qdrant 目标内定位。
model b_document_chunks {
  id                BigInt  @id @default(autoincrement())
  processing_run_id BigInt
  // 在同一个 processing run 内全局递增，所有层级共用编号。
  chunk_no          Int
  content           String  @db.LongText
  content_hash      String? @db.Char(64)
  token_count       Int?    @default(0)
  page_start        Int?
  page_end          Int?
  char_start        Int?
  char_end          Int?

  // 三层粒度：1=根，2=父，3=子。
  chunk_level     Int     @default(3)
  // 应用层保证 parent/root 同属本 run、层级合法且无环；root 为冗余导航字段。
  parent_chunk_id BigInt?
  root_chunk_id   BigInt?

  vector_id           String?         @db.VarChar(255)
  // completed 仅在向量产物已持久化且清单可恢复时写入；不需要向量的块使用 skipped。
  embedding_status    ChunkStepStatus @default(pending)
  embedding_error     String?         @db.Text
  embedded_at         DateTime?       @db.DateTime(0)
  // Qdrant 与 ES 独立重试；completed 必须核验目标写入结果，发布前另做可检索性屏障。
  vector_index_status ChunkStepStatus @default(pending)
  vector_index_error  String?         @db.Text
  vector_indexed_at   DateTime?       @db.DateTime(0)
  search_index_status ChunkStepStatus @default(pending)
  search_index_error  String?         @db.Text
  search_indexed_at   DateTime?       @db.DateTime(0)

  metadata_json Json?
  created_at    DateTime @default(now()) @db.DateTime(0)
  updated_at    DateTime @updatedAt @db.DateTime(0)

  processing_run    b_document_processing_runs @relation(fields: [processing_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chunk_processing_run")
  message_citations b_chat_message_citations[]

  child_chunks b_document_chunks[] @relation("ChunkHierarchy")
  parent       b_document_chunks?  @relation("ChunkHierarchy", fields: [parent_chunk_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([processing_run_id, chunk_no], map: "uk_run_chunk_no")
  @@index([processing_run_id, embedding_status], map: "idx_chunk_run_embedding")
  @@index([processing_run_id, vector_index_status], map: "idx_chunk_run_vector_index")
  @@index([processing_run_id, search_index_status], map: "idx_chunk_run_search_index")
  @@index([processing_run_id, chunk_level], map: "idx_chunk_run_level")
  @@index([parent_chunk_id], map: "idx_chunk_parent")
  @@index([root_chunk_id], map: "idx_chunk_root")
  @@index([vector_id], map: "idx_chunk_vector_id")
}

/// 一次上传处理或重新向量化处理批次。
/// 该表不表示用户可见的文件版本。
model b_document_processing_runs {
  id            BigInt              @id @default(autoincrement())
  document_id   BigInt
  run_no        Int
  // upload / revectorize / manual_retry。
  trigger_type  String              @db.VarChar(30)
  // queued / running / succeeded / failed / cancelled。
  status        ProcessingRunStatus @default(queued)
  // parse / chunk / embed / index / completed。
  current_stage ProcessingRunStage  @default(parse)

  source_sha256        String @db.Char(64)
  parser_config_json   Json?
  chunking_config_json Json?
  embedding_model_name String @db.VarChar(150)
  embedding_dimension  Int?

  // 下列配置在创建 run 时验证并固定，重建不得读取被修改后的默认模型配置。
  // 含 schemaVersion/provider/model/revision/dimension/normalization 等；禁止密钥。
  embedding_config_json Json
  // 规范化配置 JSON 的 SHA256；查询向量按此指纹分组路由，不能只比较维度。
  embedding_config_hash String @db.Char(64)
  // 固定 Qdrant collection/vector name/metric 与 ES 物理索引和映射版本。
  index_targets_json    Json
  // 固定 requiredTargets 和各层级参与策略；默认双路必需，skipped 必须由此授权。
  retrieval_policy_json Json

  // total 为本 run 全部层级块数；completed 为已满足各自策略的块数，不是执行次数。
  // 每块只能计数一次；发布前按块重新核对状态，不能仅相信计数器。
  total_chunks     Int @default(0)
  completed_chunks Int @default(0)
  total_tokens     Int @default(0)

  error_code    String?   @db.VarChar(100)
  error_message String?   @db.Text
  requested_by  BigInt?
  queued_at     DateTime? @db.DateTime(0)
  started_at    DateTime? @db.DateTime(0)
  finished_at   DateTime? @db.DateTime(0)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  updated_at    DateTime  @updatedAt @db.DateTime(0)

  document         b_documents                   @relation("document_processing_runs", fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_processing_run_document")
  active_document  b_documents?                  @relation("document_active_run")
  desired_document b_documents?                  @relation("document_desired_run")
  processing_tasks b_document_processing_tasks[]
  document_chunks  b_document_chunks[]

  @@unique([document_id, run_no], map: "uk_document_run_no")
  @@index([document_id, status], map: "idx_processing_run_document_status")
  @@index([status, current_stage], map: "idx_processing_run_status_stage")
}

/// 文档处理批次中的具体任务，同时保存 BullMQ Job 映射。
/// BullMQ 的队列状态保存在 Redis；本表保存业务状态和长期执行快照。
model b_document_processing_tasks {
  id                BigInt              @id @default(autoincrement())
  processing_run_id BigInt
  parent_task_id    BigInt?
  stage             ProcessingTaskStage
  // 稳定业务幂等键，例如 run:1001:embed:batch:001；不能直接用作含冒号的 BullMQ jobId。
  task_key          String              @unique(map: "uk_processing_task_key") @db.VarChar(255)
  queue_name        String              @db.VarChar(100)
  bullmq_job_id     String?             @db.VarChar(255)

  // queued / running / retrying / succeeded / failed / cancelled。
  status                 ProcessingTaskStatus @default(queued)
  attempts_allowed       Int                  @default(3)
  attempts_made          Int                  @default(0)
  progress               Int                  @default(0)
  batch_no               Int?
  scope_json             Json?
  // 只保存小型业务参数，不保存文件内容或全文文本。
  payload_json           Json?
  result_json            Json?
  // 小型清单：schemaVersion、bucket/key、sha256、format、count、配置指纹。
  // 向量本体存 MinIO；按 run/task/execution_version 隔离不可变对象，禁止保存签名 URL。
  artifact_manifest_json Json?
  // 每次领取/接管原子递增；心跳、完成及关联状态回写需在事务内校验版本和执行权。
  // 此字段不能阻止旧 Worker 写外部系统，外部仍需幂等 ID、不可变产物及清理屏障。
  execution_version      Int                  @default(0)

  worker_id          String?   @db.VarChar(100)
  locked_at          DateTime? @db.DateTime(0)
  heartbeat_at       DateTime? @db.DateTime(0)
  available_at       DateTime? @db.DateTime(0)
  last_error_code    String?   @db.VarChar(100)
  last_error_message String?   @db.Text
  started_at         DateTime? @db.DateTime(0)
  finished_at        DateTime? @db.DateTime(0)
  duration_ms        Int?
  created_at         DateTime  @default(now()) @db.DateTime(0)
  updated_at         DateTime  @updatedAt @db.DateTime(0)

  processing_run b_document_processing_runs    @relation(fields: [processing_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_processing_task_run")
  parent_task    b_document_processing_tasks?  @relation("ProcessingTaskHierarchy", fields: [parent_task_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  child_tasks    b_document_processing_tasks[] @relation("ProcessingTaskHierarchy")

  @@unique([queue_name, bullmq_job_id], map: "uk_processing_task_bullmq_job")
  @@index([processing_run_id, stage, status], map: "idx_processing_task_run_stage")
  @@index([status, available_at], map: "idx_processing_task_status_available")
  @@index([parent_task_id], map: "idx_processing_task_parent")
  @@index([status, heartbeat_at], map: "idx_processing_task_status_heartbeat")
}

// ==========================================================
// 5. 聊天与溯源模块 (Chat & RAG)
// ==========================================================

/// 用户聊天会话，保存最近使用的知识库和聊天模式。
model b_chat_sessions {
  id                        String    @id @db.Char(36)
  user_id                   BigInt
  kb_id                     BigInt?
  title                     String    @default("新会话") @db.VarChar(100)
  summary_text              String?   @db.Text
  last_selected_kb_ids_json Json?
  last_chat_mode            String?   @db.VarChar(20)
  last_message_at           DateTime? @db.DateTime(0)
  created_at                DateTime  @default(now()) @db.DateTime(0)
  updated_at                DateTime  @updatedAt @db.DateTime(0)

  chat_messages b_chat_messages[]
  b_users       b_users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_user")

  @@index([user_id], map: "idx_user_chat")
  @@index([user_id, updated_at], map: "idx_chat_user_updated")
  @@index([user_id, last_message_at, id], map: "idx_chat_user_last_message")
}

/// 聊天消息，保存用户输入、助手回答及流式响应状态。
model b_chat_messages {
  id         BigInt @id @default(autoincrement())
  session_id String @db.Char(36)
  role       String @db.VarChar(50)
  content    String @db.Text

  references           Json? // 兼容展示缓存，由 message_citations 派生；禁止作为独立权威来源
  tool_calls           Json? // 工具调用信息
  tokens_used          Int?             @default(0)
  message_status       String           @default("completed") @db.VarChar(30)
  metadata_json        Json?
  model_name           String?          @db.VarChar(100)
  // 本次消息使用的模型来源及配置 ID；配置 ID 为字符串以兼容 system-default 等哨兵值。
  model_source         ChatModelSource?
  model_config_id      String?          @db.VarChar(50)
  finish_reason        String?          @db.VarChar(30)
  trace_id             String?          @db.Char(36)
  chat_mode            String?          @db.VarChar(20)
  selected_kb_ids_json Json? // 用户选择的知识库 ID 快照
  resolved_kb_ids_json Json? // 权限解析后的知识库 ID 快照
  stream_started_at    DateTime?        @db.DateTime(0)
  stream_finished_at   DateTime?        @db.DateTime(0)

  feedback_type   String? @db.VarChar(20)
  feedback_reason String? @db.Text

  created_at        DateTime                   @default(now()) @db.DateTime(0)
  b_chat_sessions   b_chat_sessions            @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_msg_session")
  message_citations b_chat_message_citations[]

  @@index([session_id], map: "idx_session_msg")
  @@index([session_id, created_at], map: "idx_session_msg_created")
  @@index([session_id, role], map: "idx_session_role")
  @@index([trace_id], map: "idx_msg_trace")
  @@index([message_status], map: "idx_msg_status")
}

/// 消息引用记录，将回答与知识库、文档和文本块关联起来。
model b_chat_message_citations {
  id                   BigInt   @id @default(autoincrement())
  message_id           BigInt
  // 活关联仅供导航；源数据清理后置空，原始 ID 与出处保留在快照中。
  kb_id                BigInt?
  doc_id               BigInt?
  chunk_id             BigInt?
  score                Float?
  // 新引用必须写入实际摘录；兼容历史缺失数据而保留可空。
  quote                String?  @db.Text
  // 必填不可变快照：schemaVersion、原 KB/doc/run/chunk ID（字符串）、标题与页码/位置。
  // 默认保留历史摘录；彻底擦除请求需同时处理本表及 messages.references 等副本。
  source_snapshot_json Json
  // 消息内从 1 开始连续编号；不设默认值，防止多条引用默认为 0。
  order_no             Int
  created_at           DateTime @default(now()) @db.DateTime(0)

  b_chat_messages   b_chat_messages    @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_citation_message")
  b_knowledge_bases b_knowledge_bases? @relation(fields: [kb_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_citation_kb")
  b_documents       b_documents?       @relation(fields: [doc_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_citation_doc")
  b_document_chunks b_document_chunks? @relation(fields: [chunk_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_citation_chunk")

  @@unique([message_id, order_no], map: "uk_chat_citation_order")
  @@index([doc_id], map: "idx_chat_citation_doc")
  @@index([chunk_id], map: "idx_chat_citation_chunk")
  @@index([kb_id], map: "idx_chat_citation_kb")
}

// ==========================================================
// 6. 跨存储可靠事件 (Transactional Outbox)
// ==========================================================

/// 与业务变更在同一 MySQL 事务中创建；投递和消费采用至少一次语义。
/// 不关联业务外键，确保业务行被删除后清理清单仍可执行；过期归档需独立策略。
model b_outbox_events {
  id             BigInt            @id @default(autoincrement())
  // 一次业务事件的稳定唯一键；消费者也必须按该键或业务对象幂等执行。
  event_key      String            @unique(map: "uk_outbox_event_key") @db.VarChar(255)
  event_type     OutboxEventType
  aggregate_type String            @db.VarChar(50)
  // 多态业务标识：BigInt 一律十进制字符串，不建立级联外键。
  aggregate_id   String            @db.VarChar(64)
  // 含 schemaVersion、任务 ID 或清理清单/清单地址；不得保存密钥或临时签名 URL。
  payload_json   Json
  status         OutboxEventStatus @default(pending)
  // 投递尝试次数，不是业务处理次数；消费重试由 task 或清理执行协议负责。
  attempts_made  Int               @default(0)
  available_at   DateTime          @default(now()) @db.DateTime(3)
  // 领取时生成新 UUID，回写必须匹配 token，避免过期投递者覆盖新领取者。
  lock_token     String?           @db.Char(36)
  locked_until   DateTime?         @db.DateTime(3)
  dispatched_at  DateTime?         @db.DateTime(3)
  // 仅消费者确认目标效果后设置；dispatch_processing_task 表示对应任务已成功。
  completed_at   DateTime?         @db.DateTime(3)
  last_error     String?           @db.Text
  created_at     DateTime          @default(now()) @db.DateTime(3)
  updated_at     DateTime          @updatedAt @db.DateTime(3)

  @@index([status, available_at], map: "idx_outbox_dispatch")
  @@index([status, locked_until], map: "idx_outbox_lease")
  @@index([status, dispatched_at], map: "idx_outbox_reconcile")
  @@index([aggregate_type, aggregate_id], map: "idx_outbox_aggregate")
}
