# 基础设施使用远程服务；请在本地替换占位值，切勿提交真实凭据。
# 身份认证
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=604800

# 验证码
VERIFICATION_CODE_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_IP_LIMIT_MAX=20
VERIFICATION_IP_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# 头像存储
# 使用 DOCUMENT_STORAGE_BUCKET 下的 avatars/ 前缀
AVATAR_MAX_BYTES=5242880

# 文档对象存储（MinIO/S3-compatible）
DOCUMENT_STORAGE_ENDPOINT=http://127.0.0.1:19000
DOCUMENT_STORAGE_ACCESS_KEY=rag_minio
DOCUMENT_STORAGE_SECRET_KEY=rag_minio
DOCUMENT_STORAGE_BUCKET=rag-kb
DOCUMENT_STORAGE_REGION=us-east-1
DOCUMENT_STORAGE_REQUEST_TIMEOUT_MS=30000
DOCUMENT_STORAGE_STREAM_TIMEOUT_MS=300000
DOCUMENT_STORAGE_PART_SIZE=5242880
DOCUMENT_STORAGE_SESSION_TTL_SECONDS=259200

# 应用配置
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# 可选覆盖；未配置时 development 开启堆栈，production/test 关闭；production 始终关闭
# LOG_INCLUDE_STACK=true
LOG_FILE_ENABLED=true
LOG_DIRECTORY=logs
LOG_FILE_RETENTION_DAYS=14

# 数据库
# 复用已由 apps/server 完成迁移的数据库，请勿初始化或重置。
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:13306/rag_kb

# Redis 缓存
REDIS_URL=redis://127.0.0.1:16379
REDIS_PASSWORD=REPLACE_LOCALLY
REDIS_KEY_PREFIX=server-next:

# 队列与处理状态通知
BULLMQ_PREFIX=server-next:bullmq
DOCUMENT_PROCESSING_CHANNEL_PREFIX=server-next:documents:processing
DOCUMENT_PROCESSING_SSE_USER_LIMIT=4
DOCUMENT_PROCESSING_SSE_INSTANCE_LIMIT=200
DOCUMENT_PROCESSING_SSE_HEARTBEAT_MS=15000
DOCUMENT_PROCESSING_SSE_MAX_DURATION_SECONDS=1500

# Embedding Provider（Worker 必填，密钥不落库）
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Qdrant（Worker 必填）
QDRANT_URL=
QDRANT_API_KEY=

# Elasticsearch（Worker 必填）
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# 解析资源限制
PARSER_MAX_BYTES=52428800
PARSER_MAX_ZIP_FILES=10000
PARSER_MAX_UNCOMPRESSED_BYTES=524288000
# 派生产物与 tombstone 保留
FAILED_RUN_ARTIFACT_RETENTION_DAYS=7
DELETED_DOCUMENT_RETENTION_DAYS=30

# Worker 并发、批次、租约与对账周期
WORKER_CONCURRENCY=2
WORKER_BATCH_SIZE=32
WORKER_EMBEDDING_BATCH_TOKENS=8192
WORKER_PROVIDER_RATE_LIMIT_PER_SECOND=10
WORKER_TASK_TIMEOUT_MS=600000
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_LEASE_SECONDS=60
WORKER_CLEANUP_SAFETY_WINDOW_MS=60000
WORKER_RECONCILE_INTERVAL_MS=30000
WORKER_OUTBOX_BATCH_SIZE=50

# 邮件服务（可选）
# P1 启动阶段无需启用 SMTP；接入注册功能前请启用并填写完整配置。
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# 启动基础 API 无需配置 AI、Elasticsearch 或 Qdrant；文档上传接口需要上方 MinIO 配置。
