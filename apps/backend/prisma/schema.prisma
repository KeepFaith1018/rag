generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "mysql"
}

// ==========================================================
// 1. 用户与认证模块 (User & Auth)
// ==========================================================

// 前台业务系统用户（知识库的创建者与使用者）
model b_users {
  id            BigInt  @id @default(autoincrement())
  email         String  @unique(map: "uk_email") @db.VarChar(255)
  password_hash String  @db.VarChar(255)
  full_name     String? @db.VarChar(100)
  avatar_url    String? @db.VarChar(500)
  is_active     Boolean @default(true)

  // 防盗刷配额机制 (Quota Limits)
  daily_chat_limit Int    @default(50)
  token_quota      BigInt @default(1000000)
  used_tokens      BigInt @default(0)

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)

  // 关联
  chat_sessions   b_chat_sessions[]
  kb_members      b_kb_members[]
  knowledge_bases b_knowledge_bases[]
  uploaded_documents b_documents[] @relation("document_uploader")
  model_configs   b_user_model_configs[]
  kb_invitations  b_kb_invitations[]
  user_sessions   b_user_sessions[]
}

// 后台管理系统用户（系统的超级管理员与运营人员）
model sys_admins {
  id            BigInt  @id @default(autoincrement())
  username      String  @unique(map: "uk_admin_username") @db.VarChar(100)
  password_hash String  @db.VarChar(255)
  role          String  @default("admin") @db.VarChar(50) // super_admin, operator
  is_active     Boolean @default(true)

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)

  audit_logs     sys_audit_logs[]
  admin_sessions sys_admin_sessions[]
}

model sys_email_codes {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  email      String   @db.VarChar(255)
  code       String   @db.Char(6)
  purpose    Int      @db.UnsignedTinyInt
  used       Boolean  @default(false)
  expired_at DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.DateTime(0)

  @@index([email], map: "idx_email")
  @@index([email, purpose], map: "idx_email_purpose")
}

// 前台用户会话
model b_user_sessions {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  session_id         String   @unique(map: "uk_session_id") @db.Char(36)
  user_id            BigInt
  refresh_token_hash String   @unique(map: "uk_refresh_token_hash") @db.Char(64)
  user_agent         String?  @db.VarChar(255)
  revoked            Boolean  @default(false)
  expired_at         DateTime @db.DateTime(0)
  created_at         DateTime @default(now()) @db.DateTime(0)

  b_users b_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_id")
}

// 后台管理员会话
model sys_admin_sessions {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  session_id         String   @unique(map: "uk_admin_session_id") @db.Char(36)
  admin_id           BigInt
  refresh_token_hash String   @unique(map: "uk_admin_rt_hash") @db.Char(64)
  user_agent         String?  @db.VarChar(255)
  revoked            Boolean  @default(false)
  expired_at         DateTime @db.DateTime(0)
  created_at         DateTime @default(now()) @db.DateTime(0)

  sys_admins sys_admins @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id], map: "idx_admin_id")
}

// ==========================================================
// 2. 大模型配置模块 (LLM Configs)
// ==========================================================

model sys_model_configs {
  id          BigInt   @id @default(autoincrement())
  provider    String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(50)
  base_url    String?  @db.VarChar(255)
  api_key     String?  @db.VarChar(500)
  config_json Json?
  is_default  Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @db.DateTime(0)
}

model b_user_model_configs {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  provider   String   @db.VarChar(50)
  model_name String   @db.VarChar(100)
  base_url   String?  @db.VarChar(255)
  api_key    String?  @db.VarChar(500)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)

  b_users b_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_model")
}

// ==========================================================
// 3. 知识库与协作模块 (Knowledge Base & Collaboration)
// ==========================================================

model b_knowledge_bases {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.Text

  visibility            String  @default("private") @db.VarChar(50)
  status                String  @default("normal") @db.VarChar(50)
  // 仅对共享知识库生效：控制是否开源以及公开用户是否允许下载。
  is_public             Boolean @default(false)
  allow_public_download Boolean @default(false)

  owner_id   BigInt
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)

  documents      b_documents[]
  kb_members     b_kb_members[]
  kb_invitations b_kb_invitations[]

  b_users b_users @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_kb_owner")

  @@index([owner_id], map: "idx_owner")
  @@index([visibility, status], map: "idx_kb_visibility_status")
  @@index([visibility, is_public], map: "idx_kb_visibility_public")
}

model b_kb_members {
  id        BigInt   @id @default(autoincrement())
  kb_id     BigInt
  user_id   BigInt
  // 共享知识库成员角色：manager / collaborator / member
  role      String   @default("member") @db.VarChar(50)
  joined_at DateTime @default(now()) @db.DateTime(0)

  b_knowledge_bases b_knowledge_bases @relation(fields: [kb_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_kb")
  b_users           b_users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_user")

  @@unique([kb_id, user_id], map: "uk_kb_user")
  @@index([user_id], map: "fk_member_user")
}

model b_kb_invitations {
  id           BigInt    @id @default(autoincrement())
  kb_id        BigInt
  inviter_id   BigInt
  invite_code  String    @unique @db.VarChar(64)
  // 邀请加入后的目标角色：manager / collaborator / member
  role         String    @default("member") @db.VarChar(50)
  expired_at   DateTime  @db.DateTime(0)
  is_used      Boolean   @default(false)
  cancelled_at DateTime?
  accepted_by  BigInt?
  accepted_at  DateTime?
  created_at   DateTime  @default(now()) @db.DateTime(0)

  b_knowledge_bases b_knowledge_bases @relation(fields: [kb_id], references: [id], onDelete: Cascade)
  b_users           b_users           @relation(fields: [inviter_id], references: [id], onDelete: Cascade)

  @@index([kb_id], map: "idx_invite_kb")
  @@index([kb_id, is_used, expired_at], map: "idx_invite_status_lookup")
}

// ==========================================================
// 4. 文档与分块解析模块 (Documents & Chunking)
// ==========================================================

model b_documents {
  id                BigInt    @id @default(autoincrement())
  kb_id             BigInt
  uploader_id       BigInt?
  title             String    @db.VarChar(255)
  original_filename String?   @db.VarChar(255)
  file_path         String    @db.VarChar(500)
  file_hash         String?   @db.VarChar(64)
  file_size         BigInt?   @default(0)
  file_type         String?   @db.VarChar(20)
  mime_type         String?   @db.VarChar(100)
  status            String    @default("pending") @db.VarChar(50)
  error_msg         String?   @db.Text
  token_count       Int?      @default(0)
  parse_started_at  DateTime?
  parse_finished_at DateTime?
  last_reparse_at   DateTime?
  created_at        DateTime  @default(now()) @db.DateTime(0)
  updated_at        DateTime  @default(now()) @db.DateTime(0)

  document_chunks   b_document_chunks[]
  b_knowledge_bases b_knowledge_bases   @relation(fields: [kb_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doc_kb")
  b_users           b_users?            @relation("document_uploader", fields: [uploader_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_doc_uploader")

  @@index([kb_id], map: "idx_kb_id")
  @@index([uploader_id], map: "idx_doc_uploader_id")
  @@index([kb_id, uploader_id], map: "idx_doc_kb_uploader")
}

model b_document_chunks {
  id            BigInt  @id @default(autoincrement())
  doc_id        BigInt
  chunk_index   Int
  content       String  @db.LongText
  token_count   Int?    @default(0)
  page_no       Int?
  char_start    Int?
  char_end      Int?
  vector_id     String? @db.VarChar(100)
  metadata_json Json?

  embedding_status String   @default("pending") @db.VarChar(20)
  created_at       DateTime @default(now()) @db.DateTime(0)

  b_documents b_documents @relation(fields: [doc_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chunk_doc")

  @@index([doc_id, chunk_index], map: "idx_doc_chunk")
  @@index([vector_id], map: "idx_chunk_vector_id")
}

// ==========================================================
// 5. 聊天与溯源模块 (Chat & Agentic RAG)
// ==========================================================

model b_chat_sessions {
  id         String   @id @db.Char(36)
  user_id    BigInt
  kb_id      BigInt?
  title      String   @default("新会话") @db.VarChar(100)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)

  chat_messages b_chat_messages[]
  b_users       b_users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_user")

  @@index([user_id], map: "idx_user_chat")
}

model b_chat_messages {
  id         BigInt @id @default(autoincrement())
  session_id String @db.Char(36)
  role       String @db.VarChar(50)
  content    String @db.Text

  references  Json?
  tool_calls  Json?
  tokens_used Int?  @default(0)

  feedback_type   String? @db.VarChar(20)
  feedback_reason String? @db.Text

  created_at      DateTime        @default(now()) @db.DateTime(0)
  b_chat_sessions b_chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_msg_session")

  @@index([session_id], map: "idx_session_msg")
}

// ==========================================================
// 6. 系统与审计日志模块 (System & Audit)
// ==========================================================

model sys_audit_logs {
  id         BigInt   @id @default(autoincrement())
  admin_id   BigInt?
  action     String   @db.VarChar(100)
  module     String   @db.VarChar(50)
  ip_address String?  @db.VarChar(50)
  details    Json?
  created_at DateTime @default(now()) @db.DateTime(0)

  sys_admins sys_admins? @relation(fields: [admin_id], references: [id], onDelete: SetNull)

  @@index([admin_id], map: "idx_audit_admin")
  @@index([action], map: "idx_audit_action")
}

model sys_dict_type {
  id         BigInt   @id @default(autoincrement())
  code       String   @unique(map: "uk_code") @db.VarChar(100)
  name       String   @db.VarChar(100)
  remark     String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.DateTime(0)
}

model sys_dict_item {
  id         BigInt   @id @default(autoincrement())
  type_code  String   @db.VarChar(100)
  value      String   @db.VarChar(100)
  label      String   @db.VarChar(100)
  sort       Int      @default(0)
  status     Boolean  @default(true)
  created_at DateTime @default(now()) @db.DateTime(0)

  @@unique([type_code, value], map: "uk_type_value")
  @@index([type_code], map: "idx_type_code")
}
