# ═══════════════════════════════════════════
# Linsor AI — 环境配置
# ═══════════════════════════════════════════

# ── 应用 ──────────────────────────────────
PORT=3000
NODE_ENV=development

# ── 数据库 (MySQL) ─────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=13306
DATABASE_USER=root
DATABASE_PASSWORD=rag_mysql
DATABASE_NAME=rag_kb

# ── Qdrant 向量库 ─────────────────────────
QDRANT_URL="http://localhost:16333"
QDRANT_SERVICE_API_KEY=rag_qdrant

# ── Redis ─────────────────────────────────
REDIS_URL="redis://localhost:16379"
REDIS_PASSWORD=rag_redis

# ── JWT 鉴权 ──────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars_long_here
JWT_EXPIRES_IN="7d"

# ── 加密密钥 ─────────────────────────────
# ENCRYPTION_KEY: AES-256 加密密钥，最少 16 字符，生产环境建议 32 字符随机字符串
ENCRYPTION_KEY=your_encryption_key_min_16_chars
# TRANSMISSION_SECRET: 前后端传输加密密钥，最少 16 字符，需与 apps/web/.env 保持一致
TRANSMISSION_SECRET=your_transmission_secret_min_16_chars

# ── 百炼 AI 平台 (LLM / Embedding / Rerank) ─
BAILIAN_API_KEY=your_bailian_api_key
BAILIAN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

BAILIAN_LLM_MODEL=deepseek-v4-pro
BAILIAN_LLM_LIGHT_MODEL=deepseek-v4-flash

BAILIAN_EMBEDDING_MODEL=text-embedding-v4
# 向量维度，text-embedding-v4 支持 1024/512/256/128，维度越高精度越好但存储越大
BAILIAN_EMBEDDING_DIMENSIONS=1024
# 文档嵌入类型: text (纯文本) | vision (图文混合，需视觉嵌入模型)
BAILIAN_DOCUMENT_EMBEDDING_TYPE=text
BAILIAN_VISION_EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
# 每批嵌入的文档块数量，百炼 API 限制单次最多 6 条
BAILIAN_EMBED_BATCH_SIZE=10
# 嵌入请求失败重试次数
BAILIAN_EMBED_RETRY_COUNT=3
# 嵌入请求间隔 (毫秒)，用于限流避免触发 API 频率限制
BAILIAN_EMBED_REQUEST_INTERVAL_MS=1000

BAILIAN_RERANK_MODEL=qwen3-rerank
# Rerank 返回的最相关文档数量
BAILIAN_RERANK_TOP_N=10

# ── LangSmith 追踪 ─────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=Linsor

# ── 邮件 (QQ 邮箱) ─────────────────────────
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_email授权码
EMAIL_FROM=noreply@yourdomain.com

# ── Elasticsearch ──────────────────────────
ELASTICSEARCH_NODE=http://localhost:19200
ELASTICSEARCH_INDEX=kb_document_chunks_es
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# ── 文档处理 ──────────────────────────────
DOCUMENT_PROCESSING_TIMEOUT_MS=1800000
DOCUMENT_PROCESSING_TIMEOUT_SCAN_INTERVAL_MS=60000

# ── 联网搜索 (Tavily) ──────────────────────
TAVILY_API_KEY=your_tavily_api_key

# ── CORS 白名单 ──────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
